@page "/error/408"
@layout LoginLayout

<PageTitle>408 - Request Timeout</PageTitle>

<div class="error-page d-flex flex-column justify-content-center align-items-center vh-100">
    <div class="text-center">
        <img src="images/errors/waiting.gif" alt="Waiting" class="error-gif mb-4" />
        <h1 class="display-1 text-info fw-bold">408</h1>
        <h2 class="mb-3">Request Timeout</h2>
        <p class="text-muted mb-4">We waited and waited... but the request took too long. Time's up!</p>
        <a href="/" class="btn btn-info btn-lg text-white">
            <i class="bi bi-speedometer2 me-2"></i>Try Faster This Time
        </a>
    </div>
</div>
