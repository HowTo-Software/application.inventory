@page "/error/401"
@layout LoginLayout

<PageTitle>401 - Unauthorized</PageTitle>

<div class="error-page d-flex flex-column justify-content-center align-items-center vh-100">
    <div class="text-center">
        <img src="images/errors/no-entry.gif" alt="No Entry" class="error-gif mb-4" />
        <h1 class="display-1 text-warning fw-bold">401</h1>
        <h2 class="mb-3">Unauthorized</h2>
        <p class="text-muted mb-4">Hold up! You need to log in first. No ticket, no entry!</p>
        <a href="/login" class="btn btn-warning btn-lg">
            <i class="bi bi-box-arrow-in-right me-2"></i>Go to Login
        </a>
    </div>
</div>
