@page "/error/403"
@layout LoginLayout

<PageTitle>403 - Forbidden</PageTitle>

<div class="error-page d-flex flex-column justify-content-center align-items-center vh-100">
    <div class="text-center">
        <img src="images/errors/access-denied.gif" alt="Access Denied" class="error-gif mb-4" />
        <h1 class="display-1 text-danger fw-bold">403</h1>
        <h2 class="mb-3">Access Forbidden</h2>
        <p class="text-muted mb-4">You shall not pass! This area is for VIPs only.</p>
        <a href="/" class="btn btn-danger btn-lg">
            <i class="bi bi-arrow-left me-2"></i>Go Back to Safety
        </a>
    </div>
</div>
