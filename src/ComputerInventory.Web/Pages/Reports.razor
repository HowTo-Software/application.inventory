@page "/reports"
@attribute [Authorize]
@implements IDisposable
@inject IReportsService ReportsService
@inject IComputerService ComputerService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@using System.Text.Json
@using ComputerInventory.Contracts
@using Microsoft.AspNetCore.Components

<PageTitle>System Reports - VERBOSE</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-file-earmark-text me-2"></i>Verbose System Reports</h1>
        <button class="btn btn-outline-primary" @onclick="LoadSummaries" disabled="@isLoading">
            <i class="bi bi-arrow-clockwise me-2"></i>Refresh
        </button>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!reportSummaries.Any())
    {
        <EmptyState Icon="EmptyState.EmptyStateIcon.Reports"
                    Title="No reports available"
                    Description="Detailed hardware and software reports are collected automatically by the agent. Check back once agents have reported in." />
    }
    else
    {
        <!-- Computer Selection -->
        <div class="row mb-4">
            <div class="col-md-6">
                <label class="form-label">Select Computer</label>
                <select class="form-select" value="@selectedComputerId" @onchange="OnComputerSelected">
                    <option value="">-- Select a computer --</option>
                    @foreach (var s in reportSummaries)
                    {
                        <option value="@s.ComputerId" selected="@(s.ComputerId == selectedComputerId)">@s.ComputerName (@s.SerialNumber)</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                @if (isLoadingReport)
                {
                    <div class="d-flex align-items-center mt-4">
                        <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                        <span class="text-muted">Loading report...</span>
                    </div>
                }
                else if (selectedReport != null)
                {
                    <div class="alert alert-secondary mb-0 mt-4">
                        <strong>Report collected:</strong> @ToLocalTime(selectedReport.CollectedAt).ToString("g")
                    </div>
                }
            </div>
        </div>

        @if (selectedReport != null)
        {
            <!-- Report Navigation -->
            <ul class="nav nav-tabs mb-4" id="reportTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="tab-hardware" data-bs-toggle="tab" data-bs-target="#hardware" role="tab" aria-selected="true" aria-controls="hardware">
                        <i class="bi bi-cpu me-1"></i>Hardware
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-storage" data-bs-toggle="tab" data-bs-target="#storage" role="tab" aria-selected="false" aria-controls="storage">
                        <i class="bi bi-hdd me-1"></i>Storage
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-network" data-bs-toggle="tab" data-bs-target="#network" role="tab" aria-selected="false" aria-controls="network">
                        <i class="bi bi-ethernet me-1"></i>Network
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-os" data-bs-toggle="tab" data-bs-target="#os" role="tab" aria-selected="false" aria-controls="os">
                        <i class="bi bi-windows me-1"></i>OS & License
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-software" data-bs-toggle="tab" data-bs-target="#software" role="tab" aria-selected="false" aria-controls="software">
                        <i class="bi bi-box-seam me-1"></i>Software
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-security" data-bs-toggle="tab" data-bs-target="#security" role="tab" aria-selected="false" aria-controls="security">
                        <i class="bi bi-shield-check me-1"></i>Security
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-performance" data-bs-toggle="tab" data-bs-target="#performance" role="tab" aria-selected="false" aria-controls="performance">
                        <i class="bi bi-speedometer me-1"></i>Performance
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-events" data-bs-toggle="tab" data-bs-target="#events" role="tab" aria-selected="false" aria-controls="events">
                        <i class="bi bi-journal-text me-1"></i>Events
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-users" data-bs-toggle="tab" data-bs-target="#users" role="tab" aria-selected="false" aria-controls="users">
                        <i class="bi bi-people me-1"></i>Users
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                <!-- Hardware Tab -->
                <div class="tab-pane fade show active" id="hardware" role="tabpanel" aria-labelledby="tab-hardware">
                    <div class="row">
                        <!-- BIOS -->
                        <div class="col-md-6 mb-4">
                            <div class="card h-100">
                                <div class="card-header"><i class="bi bi-motherboard me-2"></i>BIOS</div>
                                <div class="card-body">
                                    <table class="table table-sm">
                                        <tr><td>Version</td><td class="text-break">@selectedReport.BiosVersion</td></tr>
                                        <tr><td>Manufacturer</td><td>@selectedReport.BiosManufacturer</td></tr>
                                        <tr><td>Serial</td><td class="text-break">@selectedReport.BiosSerialNumber</td></tr>
                                        <tr><td>SMBIOS</td><td>@selectedReport.SmbiosVersion</td></tr>
                                        <tr><td>Release Date</td><td>@selectedReport.BiosReleaseDate?.ToString("d")</td></tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Motherboard -->
                        <div class="col-md-6 mb-4">
                            <div class="card h-100">
                                <div class="card-header"><i class="bi bi-cpu me-2"></i>Motherboard</div>
                                <div class="card-body">
                                    <table class="table table-sm">
                                        <tr><td>Manufacturer</td><td>@selectedReport.MotherboardManufacturer</td></tr>
                                        <tr><td>Product</td><td>@selectedReport.MotherboardProduct</td></tr>
                                        <tr><td>Serial</td><td class="text-break">@selectedReport.MotherboardSerialNumber</td></tr>
                                        <tr><td>Version</td><td>@selectedReport.MotherboardVersion</td></tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- CPU -->
                        <div class="col-md-6 mb-4">
                            <div class="card h-100">
                                <div class="card-header"><i class="bi bi-cpu-fill me-2"></i>Processor</div>
                                <div class="card-body">
                                    <table class="table table-sm">
                                        <tr><td>Name</td><td class="text-break">@selectedReport.CpuName</td></tr>
                                        <tr><td>Manufacturer</td><td>@selectedReport.CpuManufacturer</td></tr>
                                        <tr><td>Cores</td><td>@selectedReport.CpuCores</td></tr>
                                        <tr><td>Logical Processors</td><td>@selectedReport.CpuLogicalProcessors</td></tr>
                                        <tr><td>Max Speed</td><td>@(selectedReport.CpuMaxClockSpeed.HasValue ? $"{selectedReport.CpuMaxClockSpeed} MHz" : "-")</td></tr>
                                        <tr><td>Current Speed</td><td>@(selectedReport.CpuCurrentClockSpeed.HasValue ? $"{selectedReport.CpuCurrentClockSpeed} MHz" : "-")</td></tr>
                                        <tr><td>L2 Cache</td><td>@(selectedReport.CpuL2CacheSize.HasValue ? $"{selectedReport.CpuL2CacheSize} KB" : "-")</td></tr>
                                        <tr><td>L3 Cache</td><td>@(selectedReport.CpuL3CacheSize.HasValue ? $"{selectedReport.CpuL3CacheSize} KB" : "-")</td></tr>
                                        <tr><td>Socket</td><td>@selectedReport.CpuSocketDesignation</td></tr>
                                        <tr><td>Architecture</td><td>@selectedReport.CpuArchitecture</td></tr>
                                        <tr><td>Processor ID</td><td class="text-break small">@selectedReport.CpuProcessorId</td></tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Memory -->
                        <div class="col-md-6 mb-4">
                            <div class="card h-100">
                                <div class="card-header"><i class="bi bi-memory me-2"></i>Memory</div>
                                <div class="card-body">
                                    <table class="table table-sm">
                                        <tr><td>Total Physical</td><td>@FormatBytes(selectedReport.TotalPhysicalMemory)</td></tr>
                                        <tr><td>Available Physical</td><td>@FormatBytes(selectedReport.AvailablePhysicalMemory)</td></tr>
                                        <tr><td>Total Virtual</td><td>@FormatBytes(selectedReport.TotalVirtualMemory)</td></tr>
                                        <tr><td>Available Virtual</td><td>@FormatBytes(selectedReport.AvailableVirtualMemory)</td></tr>
                                        <tr><td>Slots Used</td><td>@selectedReport.MemorySlotsUsed / @selectedReport.MemorySlots</td></tr>
                                    </table>
                                    @if (!string.IsNullOrEmpty(selectedReport.MemoryModulesJson))
                                    {
                                        <h6 class="mt-3">Memory Modules</h6>
                                        @RenderJsonTable(selectedReport.MemoryModulesJson, new[] { "DeviceLocator", "Manufacturer", "PartNumber", "Capacity", "Speed", "MemoryType" })
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- GPU -->
                        <div class="col-md-6 mb-4">
                            <div class="card h-100">
                                <div class="card-header"><i class="bi bi-gpu-card me-2"></i>Graphics</div>
                                <div class="card-body">
                                    <table class="table table-sm">
                                        <tr><td>GPU</td><td class="text-break">@selectedReport.GpuName</td></tr>
                                        <tr><td>Manufacturer</td><td>@selectedReport.GpuManufacturer</td></tr>
                                        <tr><td>VRAM</td><td>@FormatBytes(selectedReport.GpuRam)</td></tr>
                                        <tr><td>Driver Version</td><td>@selectedReport.GpuDriverVersion</td></tr>
                                        <tr><td>Driver Date</td><td>@selectedReport.GpuDriverDate?.ToString("d")</td></tr>
                                        <tr><td>Resolution</td><td>@selectedReport.GpuResolution</td></tr>
                                        <tr><td>Monitors</td><td>@selectedReport.MonitorCount</td></tr>
                                    </table>
                                    @if (!string.IsNullOrEmpty(selectedReport.GraphicsCardsJson))
                                    {
                                        <h6 class="mt-3">All Graphics Cards</h6>
                                        @RenderJsonTable(selectedReport.GraphicsCardsJson, new[] { "Name", "VideoRam", "DriverVersion", "Resolution" })
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Chassis -->
                        <div class="col-md-6 mb-4">
                            <div class="card h-100">
                                <div class="card-header"><i class="bi bi-pc-display me-2"></i>Chassis</div>
                                <div class="card-body">
                                    <table class="table table-sm">
                                        <tr><td>Manufacturer</td><td>@selectedReport.ChassisManufacturer</td></tr>
                                        <tr><td>Type</td><td>@selectedReport.ChassisType</td></tr>
                                        <tr><td>Serial</td><td class="text-break">@selectedReport.ChassisSerialNumber</td></tr>
                                        <tr><td>Asset Tag</td><td>@selectedReport.ChassisAssetTag</td></tr>
                                        <tr><td>System Family</td><td>@selectedReport.SystemFamily</td></tr>
                                        <tr><td>SKU Number</td><td>@selectedReport.SystemSkuNumber</td></tr>
                                        <AuthorizeView Roles="Admin">
                                            <Authorized>
                                                <tr><td>Machine GUID</td><td class="text-break small">@selectedReport.MachineGuid</td></tr>
                                            </Authorized>
                                            <NotAuthorized>
                                                <tr><td>Machine GUID</td><td class="text-muted fst-italic">Admin only</td></tr>
                                            </NotAuthorized>
                                        </AuthorizeView>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Battery -->
                        @if (selectedReport.HasBattery == true)
                        {
                            <div class="col-md-6 mb-4">
                                <div class="card h-100">
                                    <div class="card-header"><i class="bi bi-battery-charging me-2"></i>Battery</div>
                                    <div class="card-body">
                                        <table class="table table-sm">
                                            <tr><td>Status</td><td>@selectedReport.BatteryStatus</td></tr>
                                            <tr><td>Charge</td><td>
                                                <div class="progress progress-md">
                                                    <div class="progress-bar @(selectedReport.BatteryChargePercent >= 50 ? "bg-success" : selectedReport.BatteryChargePercent >= 20 ? "bg-warning" : "bg-danger")" 
                                                         style="width: @(selectedReport.BatteryChargePercent)%">
                                                        @(selectedReport.BatteryChargePercent)%
                                                    </div>
                                                </div>
                                            </td></tr>
                                            <tr><td>Est. Runtime</td><td>@(selectedReport.BatteryEstimatedRuntime.HasValue && selectedReport.BatteryEstimatedRuntime > 0 ? $"{selectedReport.BatteryEstimatedRuntime} min" : "N/A")</td></tr>
                                            <tr><td>Design Capacity</td><td>@(selectedReport.BatteryDesignCapacity.HasValue ? $"{selectedReport.BatteryDesignCapacity} mWh" : "-")</td></tr>
                                            <tr><td>Full Charge Capacity</td><td>@(selectedReport.BatteryFullChargeCapacity.HasValue ? $"{selectedReport.BatteryFullChargeCapacity} mWh" : "-")</td></tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Storage Tab -->
                <div class="tab-pane fade" id="storage" role="tabpanel" aria-labelledby="tab-storage">
                    <div class="row">
                        <div class="col-12 mb-4">
                            <div class="card">
                                <div class="card-header"><i class="bi bi-hdd me-2"></i>Storage Summary</div>
                                <div class="card-body">
                                    <div class="row text-center">
                                        <div class="col-md-4">
                                            <h5>Total Capacity</h5>
                                            <h3 class="text-primary">@FormatBytes(selectedReport.TotalDiskSpace)</h3>
                                        </div>
                                        <div class="col-md-4">
                                            <h5>Free Space</h5>
                                            <h3 class="text-success">@FormatBytes(selectedReport.FreeDiskSpace)</h3>
                                        </div>
                                        <div class="col-md-4">
                                            <h5>Used</h5>
                                            <h3 class="text-warning">@(selectedReport.DiskUsagePercent?.ToString("F1") ?? "0")%</h3>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(selectedReport.DisksJson))
                        {
                            <div class="col-12 mb-4">
                                <div class="card">
                                    <div class="card-header">Physical Disks</div>
                                    <div class="card-body">
                                        @RenderJsonTable(selectedReport.DisksJson, new[] { "Model", "InterfaceType", "MediaType", "Size", "SerialNumber", "Status" })
                                    </div>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(selectedReport.LogicalDrivesJson))
                        {
                            <div class="col-12 mb-4">
                                <div class="card">
                                    <div class="card-header">Logical Drives</div>
                                    <div class="card-body">
                                        @RenderJsonTable(selectedReport.LogicalDrivesJson, new[] { "DriveLetter", "Label", "FileSystem", "Size", "FreeSpace", "DriveType" })
                                    </div>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(selectedReport.PartitionsJson))
                        {
                            <div class="col-12 mb-4">
                                <div class="card">
                                    <div class="card-header">Partitions</div>
                                    <div class="card-body">
                                        @RenderJsonTable(selectedReport.PartitionsJson, new[] { "DiskIndex", "PartitionIndex", "Type", "Size", "Bootable", "PrimaryPartition" })
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Network Tab -->
                <div class="tab-pane fade" id="network" role="tabpanel" aria-labelledby="tab-network">
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <div class="card h-100">
                                <div class="card-header"><i class="bi bi-globe me-2"></i>Network Config</div>
                                <div class="card-body">
                                    <table class="table table-sm">
                                        <tr><td>Hostname</td><td>@selectedReport.DnsHostname</td></tr>
                                        <tr><td>Domain</td><td>@selectedReport.DomainName</td></tr>
                                        <tr><td>Workgroup</td><td>@selectedReport.Workgroup</td></tr>
                                        <tr><td>Domain Joined</td><td>@(selectedReport.DomainJoined == true ? "Yes" : "No")</td></tr>
                                        <tr><td>Default Gateway</td><td>@selectedReport.DefaultGateway</td></tr>
                                        <tr><td>DNS Servers</td><td class="text-break">@selectedReport.DnsServers</td></tr>
                                        <tr><td>DHCP Server</td><td>@selectedReport.DhcpServer</td></tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(selectedReport.NetworkAdaptersJson))
                        {
                            <div class="col-12 mb-4">
                                <div class="card">
                                    <div class="card-header">Network Adapters</div>
                                    <div class="card-body">
                                        @RenderJsonTable(selectedReport.NetworkAdaptersJson, new[] { "Name", "Description", "MacAddress", "IpAddresses", "Status", "Speed" })
                                    </div>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(selectedReport.SharedFoldersJson))
                        {
                            <div class="col-md-6 mb-4">
                                <div class="card h-100">
                                    <div class="card-header">Shared Folders</div>
                                    <div class="card-body">
                                        @RenderJsonTable(selectedReport.SharedFoldersJson, new[] { "Name", "Path", "Description" })
                                    </div>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(selectedReport.MappedDrivesJson))
                        {
                            <div class="col-md-6 mb-4">
                                <div class="card h-100">
                                    <div class="card-header">Mapped Drives</div>
                                    <div class="card-body">
                                        @RenderJsonTable(selectedReport.MappedDrivesJson, new[] { "DeviceID", "ProviderName" })
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- OS & License Tab -->
                <div class="tab-pane fade" id="os" role="tabpanel" aria-labelledby="tab-os">
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <div class="card h-100">
                                <div class="card-header"><i class="bi bi-windows me-2"></i>Operating System</div>
                                <div class="card-body">
                                    <table class="table table-sm">
                                        <tr><td>Name</td><td>@selectedReport.OsName</td></tr>
                                        <tr><td>Version</td><td>@selectedReport.OsVersion</td></tr>
                                        <tr><td>Build</td><td>@selectedReport.OsBuild</td></tr>
                                        <tr><td>Architecture</td><td>@selectedReport.OsArchitecture</td></tr>
                                        <AuthorizeView Roles="Admin">
                                            <Authorized>
                                                <tr><td>OS Serial</td><td class="text-break small">@selectedReport.OsSerialNumber</td></tr>
                                            </Authorized>
                                            <NotAuthorized>
                                                <tr><td>OS Serial</td><td class="text-muted fst-italic">Admin only</td></tr>
                                            </NotAuthorized>
                                        </AuthorizeView>
                                        <tr><td>Service Pack</td><td>@selectedReport.OsServicePackMajor.@selectedReport.OsServicePackMinor</td></tr>
                                        <tr><td>Locale</td><td>@selectedReport.OsLocale</td></tr>
                                        <tr><td>Language</td><td>@selectedReport.OsLanguage</td></tr>
                                        <tr><td>Install Date</td><td>@selectedReport.OsInstallDate</td></tr>
                                        <tr><td>Last Boot</td><td>@selectedReport.OsLastBootTime</td></tr>
                                        <tr><td>Uptime</td><td>@FormatUptime(selectedReport.OsUptime)</td></tr>
                                        <tr><td>Time Zone</td><td>@selectedReport.TimeZone</td></tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 mb-4">
                            <div class="card h-100">
                                <div class="card-header"><i class="bi bi-key me-2"></i>Windows License</div>
                                <div class="card-body">
                                    <table class="table table-sm">
                                        <tr>
                                            <td>Activation Status</td>
                                            <td>
                                                @if (selectedReport.WindowsIsActivated == true)
                                                {
                                                    <span class="badge bg-success">@selectedReport.WindowsActivationStatus</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">@selectedReport.WindowsActivationStatus</span>
                                                }
                                            </td>
                                        </tr>
                                        <tr><td>Product ID</td><td class="text-break small">@selectedReport.WindowsProductId</td></tr>
                                        <AuthorizeView Roles="Admin">
                                            <Authorized>
                                                <tr><td>Product Key</td><td class="text-break small font-monospace">@selectedReport.OsProductKey</td></tr>
                                            </Authorized>
                                            <NotAuthorized>
                                                <tr><td>Product Key</td><td class="text-muted fst-italic">Admin only</td></tr>
                                            </NotAuthorized>
                                        </AuthorizeView>
                                        <tr><td>Registered Owner</td><td>@selectedReport.WindowsRegisteredOwner</td></tr>
                                        <tr><td>Registered Org</td><td>@selectedReport.WindowsRegisteredOrganization</td></tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(selectedReport.EnvironmentVariablesJson))
                        {
                            <div class="col-12 mb-4">
                                <div class="card">
                                    <div class="card-header">
                                        <i class="bi bi-terminal me-2"></i>Environment Variables (System)
                                        <button class="btn btn-sm btn-outline-secondary float-end" type="button" 
                                                data-bs-toggle="collapse" data-bs-target="#envVars">
                                            Toggle
                                        </button>
                                    </div>
                                    <div class="collapse" id="envVars">
                                        <div class="card-body scroll-md">
                                            @{
                                                try
                                                {
                                                    var envVars = JsonSerializer.Deserialize<Dictionary<string, string>>(selectedReport.EnvironmentVariablesJson);
                                                    if (envVars != null)
                                                    {
                                                        var sortedEnvVars = envVars.OrderBy(x => x.Key).ToList();
                                                        <table class="table table-sm table-striped">
                                                            <thead class="sticky-header"><tr><th>Variable</th><th>Value</th></tr></thead>
                                                            <tbody>
                                                                <Virtualize Items="sortedEnvVars" Context="kv" ItemSize="35" OverscanCount="5">
                                                                    <tr><td>@kv.Key</td><td class="text-break">@kv.Value</td></tr>
                                                                </Virtualize>
                                                            </tbody>
                                                        </table>
                                                    }
                                                }
                                                catch { <span class="text-muted">Unable to parse</span> }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Software Tab -->
                <div class="tab-pane fade" id="software" role="tabpanel" aria-labelledby="tab-software">
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h5>Installed Software</h5>
                                    <h2 class="text-primary">@(selectedReport.InstalledSoftwareCount ?? 0)</h2>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h5>Windows Updates</h5>
                                    <h2 class="text-info">@(selectedReport.InstalledUpdatesCount ?? 0)</h2>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h5>Last Update</h5>
                                    <h6>@(selectedReport.LastUpdateDate?.ToString("d") ?? "N/A")</h6>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(selectedReport.InstalledSoftwareJson))
                    {
                        <div class="card mb-4">
                            <div class="card-header">
                                <i class="bi bi-box-seam me-2"></i>Installed Software
                                <input type="text" class="form-control form-control-sm d-inline-block w-25 ms-3" 
