@code {
    [SupplyParameterFromQuery(Name = "computerId")]
    public int? ComputerIdFromQuery { get; set; }

    private CancellationTokenSource _cts = new();
    private List<ReportSummaryDto> reportSummaries = new();
    private SystemDetailsReport? selectedReport;
    private int? selectedComputerId;
    private bool isLoading = true;
    private bool isLoadingReport = false;
    private string softwareFilter = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadSummaries();

        if (ComputerIdFromQuery.HasValue && reportSummaries.Any(s => s.ComputerId == ComputerIdFromQuery.Value))
        {
            selectedComputerId = ComputerIdFromQuery.Value;
            await LoadReportForComputer(ComputerIdFromQuery.Value);
        }
    }

    private async Task LoadSummaries()
    {
        isLoading = true;
        selectedReport = null;
        try
        {
            var result = await ReportsService.GetReportSummariesAsync(_cts.Token);
            reportSummaries = result.Success ? result.Data ?? new() : new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnComputerSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var computerId))
        {
            selectedComputerId = computerId;
            await LoadReportForComputer(computerId);
        }
        else
        {
            selectedComputerId = null;
            selectedReport = null;
        }
    }

    private async Task LoadReportForComputer(int computerId)
    {
        isLoadingReport = true;
        selectedReport = null;
        StateHasChanged();
        try
        {
            var result = await ReportsService.GetReportByComputerIdAsync(computerId, _cts.Token);
            selectedReport = result.Success ? result.Data : null;
        }
        finally
        {
            isLoadingReport = false;
            StateHasChanged();
        }
    }

    private string FormatBytes(long? bytes)
    {
        if (bytes == null || bytes == 0) return "0 B";
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        int order = 0;
        double size = bytes.Value;
        while (size >= 1024 && order < sizes.Length - 1)
        {
            order++;
            size /= 1024;
        }
        return $"{size:0.##} {sizes[order]}";
    }

    private string FormatUptime(long? seconds)
    {
        if (seconds == null || seconds == 0) return "N/A";
        var ts = TimeSpan.FromSeconds(seconds.Value);
        return $"{(int)ts.TotalDays}d {ts.Hours}h {ts.Minutes}m";
    }

    private string GetUsageColor(double? usage)
    {
        if (usage == null) return "bg-secondary";
        if (usage >= 90) return "bg-danger";
        if (usage >= 70) return "bg-warning";
        return "bg-success";
    }

    private RenderFragment RenderJsonTable(string json, string[] columns) => builder =>
    {
        try
        {
            var items = JsonSerializer.Deserialize<List<Dictionary<string, JsonElement>>>(json);
            if (items == null || !items.Any())
            {
                builder.AddContent(0, "No data");
                return;
            }

            builder.OpenElement(1, "table");
            builder.AddAttribute(2, "class", "table table-sm table-striped");

            // Header
            builder.OpenElement(3, "thead");
            builder.AddAttribute(30, "style", "position: sticky; top: 0; z-index: 1; background-color: var(--bs-table-bg, #fff);");
            builder.OpenElement(4, "tr");
            foreach (var col in columns)
            {
                builder.OpenElement(5, "th");
                builder.AddContent(6, col);
                builder.CloseElement();
            }
            builder.CloseElement();
            builder.CloseElement();

            // Body with Virtualize
            builder.OpenElement(7, "tbody");
            builder.OpenComponent<Virtualize<Dictionary<string, JsonElement>>>(8);
            builder.AddAttribute(9, "Items", (ICollection<Dictionary<string, JsonElement>>)items);
            builder.AddAttribute(10, "ItemSize", 35f);
            builder.AddAttribute(11, "OverscanCount", 5);
            builder.AddAttribute(12, "ChildContent",
                (RenderFragment<Dictionary<string, JsonElement>>)(item => rowBuilder =>
                {
                    rowBuilder.OpenElement(0, "tr");
                    foreach (var col in columns)
                    {
                        rowBuilder.OpenElement(1, "td");
                        rowBuilder.AddAttribute(2, "class", "text-break");
                        if (item.TryGetValue(col, out var value))
                        {
                            rowBuilder.AddContent(3, FormatJsonValue(value, col));
                        }
                        rowBuilder.CloseElement();
                    }
                    rowBuilder.CloseElement();
                }));
            builder.CloseComponent();
            builder.CloseElement();

            builder.CloseElement();
        }
        catch
        {
            builder.AddContent(0, "Unable to parse data");
        }
    };

    private RenderFragment RenderFilteredJsonTable(string json, string[] columns, string filter) => builder =>
    {
        try
        {
            var items = JsonSerializer.Deserialize<List<Dictionary<string, JsonElement>>>(json);
            if (items == null || !items.Any())
            {
                builder.AddContent(0, "No data");
                return;
            }

            // Filter items
            if (!string.IsNullOrWhiteSpace(filter))
            {
                items = items.Where(item => 
                    item.Values.Any(v => v.ToString().Contains(filter, StringComparison.OrdinalIgnoreCase))
                ).ToList();
            }

            builder.OpenElement(1, "table");
            builder.AddAttribute(2, "class", "table table-sm table-striped");

            // Header
            builder.OpenElement(3, "thead");
            builder.AddAttribute(30, "style", "position: sticky; top: 0; z-index: 1; background-color: var(--bs-table-bg, #fff);");
            builder.OpenElement(4, "tr");
            foreach (var col in columns)
            {
                builder.OpenElement(5, "th");
                builder.AddContent(6, col);
                builder.CloseElement();
            }
            builder.CloseElement();
            builder.CloseElement();

            // Body with Virtualize
            builder.OpenElement(7, "tbody");
            builder.OpenComponent<Virtualize<Dictionary<string, JsonElement>>>(8);
            builder.AddAttribute(9, "Items", (ICollection<Dictionary<string, JsonElement>>)items);
            builder.AddAttribute(10, "ItemSize", 35f);
            builder.AddAttribute(11, "OverscanCount", 5);
            builder.AddAttribute(12, "ChildContent",
                (RenderFragment<Dictionary<string, JsonElement>>)(item => rowBuilder =>
                {
                    rowBuilder.OpenElement(0, "tr");
                    foreach (var col in columns)
                    {
                        rowBuilder.OpenElement(1, "td");
                        rowBuilder.AddAttribute(2, "class", "text-break");
                        if (item.TryGetValue(col, out var value))
                        {
                            rowBuilder.AddContent(3, FormatJsonValue(value, col));
                        }
                        rowBuilder.CloseElement();
                    }
                    rowBuilder.CloseElement();
                }));
            builder.CloseComponent();
            builder.CloseElement();

            builder.CloseElement();
        }
        catch
        {
            builder.AddContent(0, "Unable to parse data");
        }
    };

    private string FormatJsonValue(JsonElement value, string columnName)
    {
        if (value.ValueKind == JsonValueKind.Null) return "-";
        
        var stringVal = value.ToString();
        
        // Format bytes for size columns
        if (columnName.Contains("Size") || columnName.Contains("Capacity") || columnName == "VideoRam" || columnName == "WorkingSetSize" || columnName == "Speed")
        {
            if (long.TryParse(stringVal, out var bytes))
            {
                if (columnName == "Speed" && bytes < 100000000) // Network speed in bps
                    return $"{bytes / 1000000} Mbps";
                return FormatBytes(bytes);
            }
        }
        
        // Format dates - convert to Central Time
        if (columnName.Contains("Date") || columnName == "TimeGenerated" || columnName == "StartTime" || columnName == "InstalledOn")
        {
            if (DateTime.TryParse(stringVal, out var date))
            {
                var localTime = ToLocalTime(date);
                return localTime.ToString("g");
            }
        }
        
        // Format booleans
        if (value.ValueKind == JsonValueKind.True) return "Yes";
        if (value.ValueKind == JsonValueKind.False) return "No";
        
        // Truncate long values
        if (stringVal.Length > 100)
            return stringVal.Substring(0, 100) + "...";
        
        return stringVal;
    }

    private static DateTime ToLocalTime(DateTime utcTime)
    {
        var utc = utcTime.Kind == DateTimeKind.Utc ? utcTime : DateTime.SpecifyKind(utcTime, DateTimeKind.Utc);
        return utc.ToLocalTime();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
