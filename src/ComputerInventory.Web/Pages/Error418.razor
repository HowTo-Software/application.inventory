@page "/error/418"
@layout LoginLayout

<PageTitle>418 - I'm a Teapot</PageTitle>

<div class="error-page d-flex flex-column justify-content-center align-items-center vh-100">
    <div class="text-center">
        <img src="images/errors/teapot.gif" alt="Teapot" class="error-gif mb-4" />
        <h1 class="display-1 fw-bold text-teapot">418</h1>
