@page "/audit-log"
@attribute [Authorize(Roles = "Admin")]
@implements IDisposable
@inject IAuditLogService AuditLogService
@inject NavigationManager Navigation

<PageTitle>Audit Log - Device Management</PageTitle>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Dismiss"></button>
    </div>
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-journal-text me-2"></i>Audit Log</h1>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-danger btn-sm" @onclick="ShowPurgeDialog" disabled="@isLoading">
                <i class="bi bi-trash"></i> Purge Old Entries
            </button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshAsync" disabled="@isLoading">
                <i class="bi bi-arrow-clockwise @(isLoading ? "spin" : "")"></i> Refresh
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small mb-1">Search</label>
                    <input type="text" class="form-control form-control-sm" placeholder="Hostname, service tag, user..."
                           @bind="searchTerm" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1">Action</label>
                    <select class="form-select form-select-sm" @bind="selectedAction" @bind:after="() => LoadPageAsync(1)">
                        <option value="">All Actions</option>
                        @if (availableActions != null)
                        {
                            @foreach (var action in availableActions)
                            {
                                <option value="@action">@action</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1">From</label>
                    <input type="date" class="form-control form-control-sm" @bind="dateFrom" @bind:after="() => LoadPageAsync(1)" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1">To</label>
                    <input type="date" class="form-control form-control-sm" @bind="dateTo" @bind:after="() => LoadPageAsync(1)" />
                </div>
                <div class="col-md-1">
                    <button class="btn btn-outline-secondary btn-sm w-100" @onclick="ClearFilters">
                        <i class="bi bi-x-circle"></i> Clear
                    </button>
                </div>
                <div class="col-md-2 text-end">
                    @if (totalCount > 0)
                    {
                        <small class="text-muted">@totalCount.ToString("N0") entries</small>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Table -->
    @if (isLoading && entries == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (entries == null || entries.Count == 0)
    {
        <EmptyState Icon="EmptyState.EmptyStateIcon.AuditLog"
                    Title="No audit log entries"
                    Description="Activity will appear here as changes are made to computers and settings." />
    }
    else
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="col-w-160">Timestamp</th>
                            <th class="col-w-150">Action</th>
                            <th class="col-w-140">Computer</th>
                            <th class="col-w-120">Service Tag</th>
                            <th>Details</th>
                            <th class="col-w-120">Changed By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in entries)
                        {
                            <tr>
                                <td>
                                    <small>@entry.ChangedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</small>
                                </td>
                                <td>
                                    <span class="badge @GetActionBadgeClass(entry.Action)">@entry.Action</span>
                                </td>
                                <td>
                                    <a href="/computers" class="text-decoration-none">@entry.ComputerName</a>
                                </td>
                                <td><small class="text-muted">@entry.SerialNumber</small></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(entry.Notes))
                                    {
                                        <small>@TruncateText(entry.Notes, 100)</small>
                                    }
                                    @if (!string.IsNullOrEmpty(entry.OldValue) || !string.IsNullOrEmpty(entry.NewValue))
                                    {
                                        <small class="text-muted">
                                            @if (!string.IsNullOrEmpty(entry.OldValue))
                                            {
                                                <span class="text-danger">@TruncateText(entry.OldValue, 40)</span>
                                            }
                                            @if (!string.IsNullOrEmpty(entry.OldValue) && !string.IsNullOrEmpty(entry.NewValue))
                                            {
                                                <i class="bi bi-arrow-right mx-1"></i>
                                            }
                                            @if (!string.IsNullOrEmpty(entry.NewValue))
                                            {
                                                <span class="text-success">@TruncateText(entry.NewValue, 40)</span>
                                            }
                                        </small>
                                    }
                                </td>
                                <td><small>@(entry.ChangedBy ?? "System")</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination pagination-sm justify-content-center">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => LoadPageAsync(1)" disabled="@(currentPage <= 1)" aria-label="First page">
                            <i class="bi bi-chevron-double-left"></i>
                        </button>
                    </li>
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => LoadPageAsync(currentPage - 1)" disabled="@(currentPage <= 1)" aria-label="Previous page">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                    </li>

                    @foreach (var p in GetPageNumbers())
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <button class="page-link" @onclick="() => LoadPageAsync(p)">@p</button>
                        </li>
                    }

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => LoadPageAsync(currentPage + 1)" disabled="@(currentPage >= totalPages)" aria-label="Next page">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </li>
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => LoadPageAsync(totalPages)" disabled="@(currentPage >= totalPages)" aria-label="Last page">
                            <i class="bi bi-chevron-double-right"></i>
                        </button>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

@if (showPurgeModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-trash me-2"></i>Purge Old Audit Entries</h5>
                    <button type="button" class="btn-close" @onclick="() => showPurgeModal = false"></button>
                </div>
                <div class="modal-body">
                    <p>This will soft-delete audit log entries older than the specified number of days.</p>
                    <div class="mb-3">
                        <label class="form-label">Delete entries older than</label>
                        <div class="input-group">
                            <input type="number" class="form-control" @bind="purgeDays" min="1" max="3650" />
                            <span class="input-group-text">days</span>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(purgeMessage))
                    {
                        <div class="alert @(purgeSuccess ? "alert-success" : "alert-danger") mb-0">
                            @purgeMessage
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showPurgeModal = false">Cancel</button>
                    <button class="btn btn-danger" @onclick="ExecutePurgeAsync" disabled="@isPurging">
                        @if (isPurging)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Purge
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AuditLogDto>? entries;
    private List<string>? availableActions;
    private string? errorMessage;
    private bool isLoading;
    private int currentPage = 1;
    private int totalCount;
    private int totalPages;
    private string? searchTerm;
    private string? selectedAction;
    private DateTime? dateFrom;
    private DateTime? dateTo;
    private System.Timers.Timer? _searchDebounce;

    // Purge state
    private bool showPurgeModal;
    private bool isPurging;
    private int purgeDays = 90;
    private string? purgeMessage;
    private bool purgeSuccess;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync(1);
    }

    private async Task LoadPageAsync(int page)
    {
        isLoading = true;
        errorMessage = null;
        currentPage = page;

        try
        {
            var result = await AuditLogService.GetAuditLogAsync(
                page, 50, selectedAction, searchTerm, dateFrom, dateTo);

            if (result.Success && result.Data != null)
            {
                entries = result.Data.Items;
                totalCount = result.Data.TotalCount;
                totalPages = result.Data.TotalPages;
                availableActions = result.Data.AvailableActions;
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "Failed to load audit log.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading audit log: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshAsync()
    {
        await LoadPageAsync(currentPage);
    }

    private void OnSearchKeyUp(KeyboardEventArgs e)
    {
        _searchDebounce?.Stop();
        _searchDebounce?.Dispose();
        _searchDebounce = new System.Timers.Timer(400);
        _searchDebounce.Elapsed += async (s, args) =>
        {
            _searchDebounce?.Stop();
            await InvokeAsync(() => LoadPageAsync(1));
        };
        _searchDebounce.AutoReset = false;
        _searchDebounce.Start();
    }

    private async Task ClearFilters()
    {
        searchTerm = null;
        selectedAction = null;
        dateFrom = null;
        dateTo = null;
        await LoadPageAsync(1);
    }

    private void ShowPurgeDialog()
    {
        purgeMessage = null;
        purgeSuccess = false;
        showPurgeModal = true;
    }

    private async Task ExecutePurgeAsync()
    {
        isPurging = true;
        purgeMessage = null;

        try
        {
            var result = await AuditLogService.PurgeAsync(purgeDays);
            if (result.Success)
            {
                purgeSuccess = true;
                purgeMessage = $"Successfully purged entries older than {purgeDays} days.";
                await LoadPageAsync(1);
            }
            else
            {
                purgeSuccess = false;
                purgeMessage = result.ErrorMessage ?? "Failed to purge entries.";
            }
        }
        catch (Exception ex)
        {
            purgeSuccess = false;
            purgeMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isPurging = false;
        }
    }

    private IEnumerable<int> GetPageNumbers()
    {
        const int maxVisible = 7;
        int start = Math.Max(1, currentPage - maxVisible / 2);
        int end = Math.Min(totalPages, start + maxVisible - 1);
        start = Math.Max(1, end - maxVisible + 1);
        return Enumerable.Range(start, end - start + 1);
    }

    private static string GetActionBadgeClass(string action) => action switch
    {
        "Heartbeat" => "bg-secondary",
        "AgentUpdated" => "bg-info text-dark",
        "UpdateCompleted" => "bg-success",
        "UpdateFailed" => "bg-danger",
        "ForceReinstallAutoEscalated" => "bg-warning text-dark",
        _ when action.StartsWith("Checked in") => "bg-primary",
        _ when action.StartsWith("Checked out") || action.Contains("check-out") => "bg-dark",
        _ => "bg-secondary"
    };

    private static string TruncateText(string text, int maxLength) =>
        text.Length <= maxLength ? text : text[..maxLength] + "...";

    public void Dispose()
    {
        _searchDebounce?.Stop();
        _searchDebounce?.Dispose();
    }
}
