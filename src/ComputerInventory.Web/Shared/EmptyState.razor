@* Reusable empty-state component with illustration, title, description, and optional action *@

<div class="empty-state">
    <div class="empty-state-illustration">
        @switch (Icon)
        {
            case EmptyStateIcon.Computers:
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" fill="none" aria-hidden="true">
                    <rect x="30" y="20" width="140" height="90" rx="8" stroke="#b0bec5" stroke-width="2" fill="#f5f7fa"/>
                    <rect x="40" y="30" width="120" height="65" rx="4" fill="#e3eaf2"/>
                    <rect x="75" y="115" width="50" height="8" rx="3" fill="#b0bec5"/>
                    <rect x="60" y="123" width="80" height="4" rx="2" fill="#cfd8dc"/>
                    <circle cx="100" cy="62" r="18" fill="#dce4ed"/>
                    <line x1="90" y1="55" x2="110" y2="70" stroke="#90a4ae" stroke-width="2.5" stroke-linecap="round"/>
                    <line x1="110" y1="55" x2="90" y2="70" stroke="#90a4ae" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
                break;

            case EmptyStateIcon.Departments:
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" fill="none" aria-hidden="true">
                    <rect x="65" y="15" width="70" height="40" rx="6" stroke="#b0bec5" stroke-width="2" fill="#f5f7fa"/>
                    <circle cx="100" cy="30" r="8" fill="#dce4ed"/>
                    <rect x="82" y="42" width="36" height="4" rx="2" fill="#cfd8dc"/>
                    <line x1="100" y1="55" x2="100" y2="75" stroke="#b0bec5" stroke-width="2"/>
                    <line x1="45" y1="75" x2="155" y2="75" stroke="#b0bec5" stroke-width="2"/>
                    <line x1="45" y1="75" x2="45" y2="90" stroke="#b0bec5" stroke-width="2"/>
                    <line x1="100" y1="75" x2="100" y2="90" stroke="#b0bec5" stroke-width="2"/>
                    <line x1="155" y1="75" x2="155" y2="90" stroke="#b0bec5" stroke-width="2"/>
                    <rect x="20" y="90" width="50" height="35" rx="6" stroke="#b0bec5" stroke-width="2" fill="#f5f7fa"/>
                    <rect x="30" y="100" width="30" height="3" rx="1.5" fill="#dce4ed"/>
                    <rect x="30" y="107" width="20" height="3" rx="1.5" fill="#e3eaf2"/>
                    <rect x="75" y="90" width="50" height="35" rx="6" stroke="#b0bec5" stroke-width="2" fill="#f5f7fa"/>
                    <rect x="85" y="100" width="30" height="3" rx="1.5" fill="#dce4ed"/>
                    <rect x="85" y="107" width="20" height="3" rx="1.5" fill="#e3eaf2"/>
                    <rect x="130" y="90" width="50" height="35" rx="6" stroke="#b0bec5" stroke-width="2" fill="#f5f7fa"/>
                    <rect x="140" y="100" width="30" height="3" rx="1.5" fill="#dce4ed"/>
                    <rect x="140" y="107" width="20" height="3" rx="1.5" fill="#e3eaf2"/>
                </svg>
                break;

            case EmptyStateIcon.Locations:
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" fill="none" aria-hidden="true">
                    <ellipse cx="100" cy="135" rx="60" ry="10" fill="#e3eaf2"/>
                    <path d="M100 15C78 15 60 33 60 55C60 85 100 130 100 130C100 130 140 85 140 55C140 33 122 15 100 15Z" stroke="#b0bec5" stroke-width="2" fill="#f5f7fa"/>
                    <circle cx="100" cy="55" r="18" fill="#dce4ed"/>
                    <circle cx="100" cy="55" r="8" fill="#cfd8dc"/>
                </svg>
                break;

            case EmptyStateIcon.Maintenance:
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" fill="none" aria-hidden="true">
                    <rect x="40" y="25" width="120" height="110" rx="8" stroke="#b0bec5" stroke-width="2" fill="#f5f7fa"/>
                    <rect x="55" y="50" width="90" height="8" rx="3" fill="#e3eaf2"/>
                    <rect x="55" y="68" width="70" height="8" rx="3" fill="#e3eaf2"/>
                    <rect x="55" y="86" width="80" height="8" rx="3" fill="#e3eaf2"/>
                    <rect x="55" y="104" width="50" height="8" rx="3" fill="#e3eaf2"/>
                    <circle cx="150" cy="30" r="22" fill="#f5f7fa" stroke="#b0bec5" stroke-width="2"/>
                    <path d="M142 30L148 36L158 24" stroke="#90a4ae" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                break;

            case EmptyStateIcon.Users:
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" fill="none" aria-hidden="true">
                    <circle cx="100" cy="50" r="25" fill="#e3eaf2" stroke="#b0bec5" stroke-width="2"/>
                    <circle cx="100" cy="42" r="10" fill="#dce4ed"/>
                    <path d="M80 58C85 68 93 73 100 73C107 73 115 68 120 58" fill="#dce4ed"/>
                    <path d="M55 120C55 95 75 80 100 80C125 80 145 95 145 120" stroke="#b0bec5" stroke-width="2" fill="#f5f7fa"/>
                    <circle cx="60" cy="60" r="15" fill="#eef1f5" stroke="#cfd8dc" stroke-width="1.5"/>
                    <circle cx="140" cy="60" r="15" fill="#eef1f5" stroke="#cfd8dc" stroke-width="1.5"/>
                </svg>
                break;

            case EmptyStateIcon.Reports:
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" fill="none" aria-hidden="true">
                    <rect x="40" y="15" width="100" height="130" rx="6" stroke="#b0bec5" stroke-width="2" fill="#f5f7fa"/>
                    <rect x="55" y="35" width="70" height="6" rx="3" fill="#dce4ed"/>
                    <rect x="55" y="50" width="50" height="6" rx="3" fill="#e3eaf2"/>
                    <rect x="55" y="70" width="70" height="35" rx="4" fill="#e3eaf2"/>
                    <rect x="60" y="78" width="8" height="20" rx="2" fill="#cfd8dc"/>
                    <rect x="73" y="83" width="8" height="15" rx="2" fill="#cfd8dc"/>
                    <rect x="86" y="75" width="8" height="23" rx="2" fill="#cfd8dc"/>
                    <rect x="99" y="80" width="8" height="18" rx="2" fill="#cfd8dc"/>
                    <rect x="112" y="88" width="8" height="10" rx="2" fill="#cfd8dc"/>
                    <rect x="55" y="115" width="70" height="6" rx="3" fill="#e3eaf2"/>
                    <rect x="55" y="128" width="45" height="6" rx="3" fill="#e3eaf2"/>
                    <circle cx="155" cy="110" r="25" fill="#f5f7fa" stroke="#b0bec5" stroke-width="2"/>
                    <circle cx="155" cy="110" r="10" stroke="#90a4ae" stroke-width="2"/>
                    <line x1="162" y1="118" x2="175" y2="131" stroke="#90a4ae" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
                break;

            case EmptyStateIcon.AuditLog:
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" fill="none" aria-hidden="true">
                    <rect x="35" y="15" width="130" height="130" rx="8" stroke="#b0bec5" stroke-width="2" fill="#f5f7fa"/>
                    <circle cx="60" cy="42" r="6" fill="#dce4ed"/>
                    <rect x="75" y="39" width="75" height="6" rx="3" fill="#e3eaf2"/>
                    <circle cx="60" cy="62" r="6" fill="#dce4ed"/>
                    <rect x="75" y="59" width="60" height="6" rx="3" fill="#e3eaf2"/>
                    <circle cx="60" cy="82" r="6" fill="#dce4ed"/>
                    <rect x="75" y="79" width="70" height="6" rx="3" fill="#e3eaf2"/>
                    <circle cx="60" cy="102" r="6" fill="#e3eaf2"/>
                    <rect x="75" y="99" width="55" height="6" rx="3" fill="#eef1f5"/>
                    <circle cx="60" cy="122" r="6" fill="#e3eaf2"/>
                    <rect x="75" y="119" width="65" height="6" rx="3" fill="#eef1f5"/>
                </svg>
                break;

            case EmptyStateIcon.Packages:
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" fill="none" aria-hidden="true">
                    <rect x="45" y="35" width="110" height="90" rx="6" stroke="#b0bec5" stroke-width="2" fill="#f5f7fa"/>
                    <line x1="100" y1="35" x2="100" y2="125" stroke="#cfd8dc" stroke-width="1.5"/>
                    <line x1="45" y1="65" x2="155" y2="65" stroke="#cfd8dc" stroke-width="1.5"/>
                    <polygon points="100,10 155,35 100,45 45,35" stroke="#b0bec5" stroke-width="2" fill="#e3eaf2"/>
                    <line x1="100" y1="10" x2="100" y2="45" stroke="#cfd8dc" stroke-width="1.5"/>
                    <circle cx="100" cy="85" r="15" fill="#e3eaf2" stroke="#b0bec5" stroke-width="1.5"/>
                    <path d="M94 85L98 89L106 81" stroke="#90a4ae" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                break;

            case EmptyStateIcon.Versions:
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" fill="none" aria-hidden="true">
                    <line x1="60" y1="20" x2="60" y2="140" stroke="#cfd8dc" stroke-width="2"/>
                    <circle cx="60" cy="35" r="8" fill="#e3eaf2" stroke="#b0bec5" stroke-width="2"/>
                    <rect x="78" y="27" width="80" height="16" rx="4" fill="#f5f7fa" stroke="#b0bec5" stroke-width="1.5"/>
                    <rect x="85" y="33" width="50" height="4" rx="2" fill="#dce4ed"/>
                    <circle cx="60" cy="75" r="8" fill="#e3eaf2" stroke="#b0bec5" stroke-width="2"/>
                    <rect x="78" y="67" width="80" height="16" rx="4" fill="#f5f7fa" stroke="#b0bec5" stroke-width="1.5"/>
                    <rect x="85" y="73" width="40" height="4" rx="2" fill="#dce4ed"/>
                    <circle cx="60" cy="115" r="8" fill="#eef1f5" stroke="#cfd8dc" stroke-width="2"/>
                    <rect x="78" y="107" width="80" height="16" rx="4" fill="#f9fafb" stroke="#e3eaf2" stroke-width="1.5"/>
                    <rect x="85" y="113" width="55" height="4" rx="2" fill="#eef1f5"/>
                </svg>
                break;

            default:
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" fill="none" aria-hidden="true">
                    <rect x="40" y="25" width="120" height="110" rx="8" stroke="#b0bec5" stroke-width="2" fill="#f5f7fa"/>
                    <circle cx="100" cy="70" r="20" fill="#e3eaf2"/>
                    <rect x="95" y="60" width="10" height="15" rx="2" fill="#cfd8dc"/>
                    <circle cx="100" cy="85" r="2.5" fill="#cfd8dc"/>
                </svg>
                break;
        }
    </div>
    <h5 class="empty-state-title">@Title</h5>
    <p class="empty-state-description">@Description</p>
    @if (ActionText != null && ActionClicked.HasDelegate)
    {
        <button class="btn btn-primary" @onclick="ActionClicked">
            <i class="bi @ActionIcon me-2"></i>@ActionText
        </button>
    }
</div>

@code {
    [Parameter] public EmptyStateIcon Icon { get; set; } = EmptyStateIcon.Default;
    [Parameter] public string Title { get; set; } = "Nothing here yet";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string? ActionText { get; set; }
    [Parameter] public string ActionIcon { get; set; } = "bi-plus-lg";
    [Parameter] public EventCallback ActionClicked { get; set; }

    public enum EmptyStateIcon
    {
        Default,
        Computers,
        Departments,
        Locations,
        Maintenance,
        Users,
        Reports,
        AuditLog,
        Packages,
        Versions
    }
}
