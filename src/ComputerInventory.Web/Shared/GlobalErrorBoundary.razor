@using Microsoft.Extensions.Logging
@inject ILogger<GlobalErrorBoundary> Logger
@inject NavigationManager Navigation

<ErrorBoundary @ref="_errorBoundary">
    <ChildContent>
        @ChildContent
    </ChildContent>
    <ErrorContent Context="ex">
        @{ Logger.LogError(ex, "Unhandled exception caught by GlobalErrorBoundary"); }
        <div class="global-error-container" role="alert">
            <div class="global-error-card">
                <i class="bi bi-exclamation-triangle-fill global-error-icon"></i>
                <h3 class="mt-3 mb-2">Something went wrong</h3>
                <p class="text-muted mb-4">An unexpected error occurred while loading this page. You can try again or navigate to another page.</p>
                <div class="d-flex gap-2 justify-content-center">
                    <button class="btn btn-primary" @onclick="Recover">
                        <i class="bi bi-arrow-clockwise me-1"></i>Try Again
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="GoHome">
                        <i class="bi bi-house-door me-1"></i>Go Home
                    </button>
                </div>
            </div>
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    private ErrorBoundary? _errorBoundary;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override void OnParametersSet()
    {
        // Auto-recover when the user navigates to a different page
        _errorBoundary?.Recover();
    }

    private void Recover()
    {
        _errorBoundary?.Recover();
    }

    private void GoHome()
    {
        _errorBoundary?.Recover();
        Navigation.NavigateTo("/");
    }
}
