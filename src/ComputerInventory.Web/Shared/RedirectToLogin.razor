@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var currentUri = Navigation.ToBaseRelativePath(Navigation.Uri);
        var loginUrl = string.IsNullOrEmpty(currentUri) || currentUri == "login"
            ? "/login"
            : $"/login?returnUrl={Uri.EscapeDataString(currentUri)}";
        Navigation.NavigateTo(loginUrl);
    }
}
