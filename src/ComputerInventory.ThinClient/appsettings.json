{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "SourceName": "ComputerInventoryAgent",
      "LogLevel": {
        "Default": "Warning"
      }
    }
  },
  "ApiSettings": {
    "BaseUrl": "http://localhost:5010",
    "FallbackUrls": [],
    "ApiKey": ""
  },
  "AgentSettings": {
    "CheckInIntervalMinutes": 5,
    "HeartbeatIntervalMinutes": 1,
    "DetailedReportIntervalMinutes": 30,
    "ReportHardwareChanges": true,
    "EnableAutoCheckOut": true,
    "IdleTimeoutMinutes": 30,
    "StartupDelaySeconds": 5,
    "MaxNetworkWaitMinutes": 3,
    "MaxRegistrationRetries": 10,
    "RegistrationRetryDelaySeconds": 15,
    "EnableAutoUpdate": true,
    "UpdateCheckIntervalMinutes": 5,
    "MaxDownloadSpeedKbps": 0,
    "EnableLastResortReinstall": true,
    "LastResortFailureThreshold": 5,
    "LastResortCooldownHours": 1,
    "MaxBackupsToKeep": 1
  },
  "FileLogging": {
    "Enabled": true,
    "LogPath": "logs",
    "RetainDays": 7
  }
}
