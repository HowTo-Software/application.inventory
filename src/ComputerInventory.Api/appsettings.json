{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 104857600,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "ComputerInventoryApi",
    "Audience": "ComputerInventoryClient",
    "ExpirationInMinutes": 60,
    "RefreshTokenExpirationInDays": 7
  },
  "AgentSettings": {
    "ApiKey": "",
    "ServerUrl": "",
    "HeartbeatIntervalMinutes": 5,
    "CheckInIntervalMinutes": 15,
    "IdleTimeoutMinutes": 30,
    "EnableAutoCheckOut": true,
    "AutoEscalateMinutes": 10
  },
  "MapSettings": {
    "GeoLocationRefreshIntervalHours": 6
  },
  "GeoLocation": {
    "BaseUrl": "http://ip-api.com",
    "LookupPathTemplate": "/json/{ip}?fields=status,message,country,countryCode,region,regionName,city,lat,lon,timezone,isp"
  },
  "DatabaseMaintenance": {
    "OfflineCheckIntervalMinutes": 1,
    "CleanupIntervalHours": 24,
    "OfflineThresholdMinutes": 5,
    "SystemDetailsRetentionDays": 30,
    "RestorePointRetentionDays": 90,
    "HistoryRetentionDays": 365,
    "MaxSystemDetailsPerComputer": 100,
    "MaxRestorePointsPerComputer": 50
  },
  "RateLimiting": {
    "Enabled": true,
    "DefaultRequestsPerMinute": 100,
    "AgentRequestsPerMinute": 1000,
    "AuthRequestsPerMinute": 10,
    "QueryRequestsPerMinute": 60
  },
  "CacheSettings": {
    "ComputerListCacheSeconds": 15,
    "ComputerStatsCacheSeconds": 30,
    "DashboardCacheSeconds": 15,
    "MapLocationsCacheSeconds": 30
  },
  "AgentFiles": {
    "AgentDirectory": "agent",
    "UpdateSubdirectory": "update",
    "PackagesSubdirectory": "packages",
    "VersionFileName": "agent-version.txt",
    "UpdateJsonFileName": "update.json",
    "ChecksumFileName": "checksum.txt",
    "InstallerFileName": "ComputerInventoryAgent.zip",
    "UpdatePackageFileName": "agent-update.zip"
  },
  "BackgroundTaskQueue": {
    "Capacity": 100
  },
  "CorsOrigins": [],
  "EmailSettings": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPass": "",
    "FromAddress": "noreply@example.com",
    "FromName": "Computer Inventory"
  },
"AllowedHosts": "*",
"CaptchaSettings": {
  "SiteKey": "",
  "SecretKey": ""
}
}
