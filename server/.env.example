# Server Configuration
# Copy this file to .env and update values for your environment

# SQL Server Configuration
SA_PASSWORD=ChangeMe!StrongPassword123
MSSQL_PID=Express

# API Configuration
ASPNETCORE_ENVIRONMENT=Production
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_64_CHAR_SECRET_KEY
JWT_ISSUER=ComputerInventoryApi
JWT_AUDIENCE=ComputerInventoryClient
JWT_EXPIRATION_MINUTES=60

# Database Connection
DB_CONNECTION_STRING=Server=YOUR_SERVER,1433;Database=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;

# Agent Configuration
AGENT_API_KEY=
AGENT_SERVER_URL=http://your-server:5010
AGENT_HEARTBEAT_INTERVAL=5
AGENT_CHECKIN_INTERVAL=15
AGENT_IDLE_TIMEOUT=30
AGENT_ENABLE_AUTO_CHECKOUT=true
