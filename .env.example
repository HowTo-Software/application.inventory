# ============================================
# Computer Inventory — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to source control.
# ============================================

# --- Database (production) ---
DB_CONNECTION_STRING=Server=YOUR_SERVER,1433;Database=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;Max Pool Size=100;Min Pool Size=5;Connection Timeout=30;Command Timeout=60;

# --- Database (dev SQL Server container) ---
SA_PASSWORD=ChangeMe!StrongPassword123
MSSQL_PID=Express

# --- JWT Authentication ---
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_64_CHAR_SECRET_KEY_GENERATED_VIA_OPENSSL
JWT_ISSUER=ComputerInventoryApi
JWT_AUDIENCE=ComputerInventoryClient
JWT_EXPIRATION_MINUTES=60

# --- Agent Settings ---
# Generate a secure key: powershell -c "[Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }) -as [byte[]])"
AGENT_API_KEY=REPLACE_WITH_A_RANDOM_64_CHAR_SECRET_KEY
AGENT_SERVER_URL=http://your-server:5010

# --- Code Signing (thin-client builds) ---
PFX_PASSWORD=

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Production
